{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install eslint --fix --quiet $CLAUDE_FILE_PATHS 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
